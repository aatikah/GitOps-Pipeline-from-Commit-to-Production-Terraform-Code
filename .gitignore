# Terraform working directory
.terraform/

# State files
*.tfstate
*.tfstate.*

# Variable files may contain sensitive values
*.tfvars
*.tfvars.json
!*.tfvars.example

# Plans and crash logs
tfplan
*.tfplan
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local CLI configuration
.terraformrc
terraform.rc

# Lock file (also ignored by the repository-level .gitignore)
.terraform.lock.hcl

# OS/editor
.DS_Store
.vscode/
